{
    "name": "reverse-proxy",
    "version": "1.0.0",
    "description": "Minimal multi-domain HTTP, HTTPS and WebSocket reverse proxy for Node.js with no runtime dependencies",
    "private": true,
    "main": "app/index.js",
    "scripts": {
        "live": "node --env-file=.env app/index.js",
        "dev": "node --env-file=.env.dev app/index.js",
        "test": "node --test",
        "lint": "eslint . && prettier --check .",
        "init": "npm install && node system/init.js",
        "install-service": "node system/service.js install",
        "uninstall-service": "node system/service.js uninstall",
        "create-certs": "node system/certs.js",
        "clear-logs": "node system/logs.js"
    },
    "type": "module",
    "devDependencies": {
        "eslint": "^8.57.1",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.4.1",
        "prettier": "^3.5.3"
    },
    "author": "imagickey",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/iMagicKey/reverse-proxy.git"
    },
    "bugs": {
        "url": "https://github.com/iMagicKey/reverse-proxy/issues"
    },
    "homepage": "https://github.com/iMagicKey/reverse-proxy#readme",
    "engines": {
        "node": ">=20.6.0"
    }
}
