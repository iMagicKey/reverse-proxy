# Required. Directory under app/config/ with certs/key.pem, certs/cert.pem and optional logger.json: live or dev.
# npm run live and npm run dev read this from .env and .env.dev.
APP_ENV=live

# Required. JSON array of routes, use [] for none. Both values must be "host:port".
# from: public hostname and port, matched against the request's Host header.
# to:   backend address. Requests received over HTTP use HTTP to the backend, requests received over HTTPS use HTTPS.
DOMAINS='[{"from":"example.com:80","to":"127.0.0.1:3000"},{"from":"example.com:443","to":"127.0.0.1:3443"}]'
